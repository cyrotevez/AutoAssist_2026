# Copy this file to ".env" (same folder) and fill in your values.
GROQ_API_KEY=paste_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b
SECRET_KEY=change-me-to-any-long-random-text

# Demo mechanics are created around this point (default: Kampala).
# Change it if you want the demo data around another place, then delete
# autoassist.db and restart the server.
SEED_CENTER_LAT=0.3476
SEED_CENTER_LNG=32.5825
